# ---------------------------------------------
# Airdrop Farmer Environment (Standalone Module)
# ---------------------------------------------
# This file is ONLY for airdrop-farmer/farmer.py.
# It does not share state with litcoin_miner.py.

# --- Runtime mode ---
# Start in dry-run mode first.
# DRY_RUN=true means: build + print txs but do not broadcast.
DRY_RUN=true

# --- Network ---
# Default: local Anvil RPC from your requirement.
# Live flip: set RPC_URL to Base Sepolia and use a funded test key.
RPC_URL=http://127.0.0.1:8545
# Example live testnet:
# RPC_URL=https://sepolia.base.org

# --- Wallet keys ---
# Use first private key printed by Anvil when it starts.
# Example only - replace with YOUR Anvil key output.
PRIVATE_KEY=0xREPLACE_WITH_ANVIL_ACCOUNT_0_PRIVATE_KEY

# Dedicated receiver wallet where swapped tokens are forwarded.
DEDICATED_WALLET=0xYourRealDedicatedHere

# --- Contracts (Base mainnet addresses provided) ---
# Aerodrome Router (Base)
ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43

# USDC (Base)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Target token address for swap destination.
# AERO on Base (example):
TARGET_TOKEN_ADDRESS=0x940181a94A35A4569E4529A3CDfB74e38FD98631
TARGET_TOKEN_SYMBOL=AERO

# --- Aerodrome route params ---
# stable=false for volatile pools (common for USDC->AERO/LITCOIN).
# Set true only if you are certain pool is stable.
ROUTE_STABLE=false

# Factory can remain zero address for router defaults unless needed.
ROUTE_FACTORY=0x0000000000000000000000000000000000000000

# --- Trade controls ---
# Minimum USDC needed to trigger a swap.
MIN_USDC_BALANCE=0.001

# Small daily amount used for point farming.
# Amount is in whole-token units (USDC has 6 decimals).
SWAP_AMOUNT_USDC=0.01

# Set slippage (in basis points).
# Example: 100 = 1%, 50 = 0.5%
SLIPPAGE_BPS=100

# Router deadline buffer in seconds.
DEADLINE_SECONDS=1200

# Daily interval (86400 = 24h).
LOOP_SECONDS=86400

# Retry policy per cycle.
MAX_RETRIES=3
RETRY_DELAY_SECONDS=15

# --- Optional gas behavior ---
# Leave empty to use node defaults, or set explicit gwei.
# GAS_PRICE_GWEI=

# --- Important live flip notes ---
# 1) Set DRY_RUN=false
# 2) Set RPC_URL=https://sepolia.base.org (or Base mainnet if desired)
# 3) Replace PRIVATE_KEY with your dedicated funded key
# 4) Fund with small USDC (testnet: faucet.circle.com)
# 5) Keep DEDICATED_WALLET set to your real receiver wallet
