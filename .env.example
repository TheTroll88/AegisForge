# ============================================
# AegisForge Environment Configuration
# ============================================
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# --- AI Chat (OpenRouter / OpenAI) ---
OPENAI_API_KEY=your-openrouter-or-openai-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# --- Wallet (MetaMask / eth-account) ---
METAMASK_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
METAMASK_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
METAMASK_RPC_URL=https://sepolia.base.org
METAMASK_CHAIN_ID=84532

# --- RPC Endpoints ---
BASE_RPC_URL=https://sepolia.base.org
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# --- Whale Tracker ---
ETHERSCAN_API_KEY=your-etherscan-key
BASESCAN_API_KEY=your-basescan-key
BSCSCAN_API_KEY=your-bscscan-key

# --- Trading Mode ---
# MICRO_MODE=true uses real on-chain micro trades
# PAPER_MODE=true uses simulated paper trading (default)
MICRO_MODE=false
PAPER_MODE=true
