# LITCOIN Miner Configuration
# Copy this file to .env and fill in your keys

# REQUIRED: Bankr API Key (get one at https://bankr.bot/api)
BANKR_API_KEY=bk_YOUR_KEY

# OPTIONAL: AI Provider API Key (enables relay mining and research mining)
# Providers: OpenAI, OpenRouter, Groq, Together AI, Anthropic, Google, Bankr LLM Gateway, local Ollama
AI_API_KEY=sk_YOUR_KEY

# OPTIONAL: AI Provider URL (default: OpenAI)
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
# Local Ollama: http://localhost:11434/v1
AI_URL=https://api.openai.com/v1

# OPTIONAL: Model name (default: gpt-4o-mini)
# OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# OpenRouter: openrouter/auto, anthropic/claude-opus, google/gemini-2.5-flash
# Groq: mixtral-8x7b-32768, llama2-70b-4096
MODEL=gpt-4o-mini
